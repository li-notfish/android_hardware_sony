allow hal_power_default vendor_latency_device:chr_file rw_file_perms;
allow hal_power_default proc:file rw_file_perms;
allow hal_power_default vendor_sysfs_msm_perf:file rw_file_perms;
allow hal_power_default sysfs:file rw_file_perms;
allow hal_power_default sysfs:file open;

allow hal_power_default sysfs_devices_system_cpu:file rw_file_perms;

rw_dir_file(hal_power_default, sysfs_devices_system_cpu)
rw_dir_file(hal_power_default, sysfs_dp)
rw_dir_file(hal_power_default, sysfs_tsp)
rw_dir_file(hal_power_default, proc)

# Allow PowerHAL to adjust scheduler attributes for apps
allow hal_power_default { 
    platform_app 
    priv_app 
    untrusted_app 
    system_app 
}:process setsched;

typeattribute hal_power_default mlstrustedsubject; # Allows HAL to talk to apps with categories (c512, etc)
allow hal_power_default { platform_app priv_app untrusted_app system_app }:process { getsched setsched };

# Set scheduling info for apps (for adpf)
allow hal_power_default appdomain:process { getsched setsched };
allow hal_power_default self:capability sys_nice;

# Set scheduling info for surfaceflinger (for adpf)
allow hal_power_default surfaceflinger:process setsched;

# Set scheduling info for HWC (for adpf)
allow hal_power_default hal_graphics_composer_default:process setsched;

# Set scheduling info for system_server (for adpf)
allow hal_power_default system_server:process setsched;

# Allow reading proc files for CPU statistics.
allow hal_power_default proc_stat:file r_file_perms;

# Allow read/write thermal sysfs and property
allow hal_power_default sysfs_thermal:dir r_dir_perms;
allow hal_power_default sysfs_thermal:file rw_file_perms;
allow hal_power_default sysfs_thermal:lnk_file r_file_perms;

allow hal_power_default self:capability sys_nice;
